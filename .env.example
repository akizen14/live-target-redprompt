# ── Inbound (what red-prompt presents to THIS app) ───────────────────────────
# Required. Any client without this key gets 401. This is the ONLY thing keeping
# the deployed endpoint from being a free public LLM proxy — never leave it empty.
RP_TARGET_API_KEY=change-me-to-a-long-random-string

# Which header the app accepts the key in: bearer | x-api-key
# Use x-api-key to exercise red-prompt's non-bearer auth path (redprompt/auth.py).
RP_TARGET_AUTH_SCHEME=bearer

# Admin key for POST /_control/patch|unpatch (the retest-loop demo). Must differ
# from RP_TARGET_API_KEY, so a successful prompt-injection can never flip the mode.
RP_ADMIN_KEY=change-me-too

# ── Upstream (the real model this app wraps) ─────────────────────────────────
# Groq is the default: free tier, fast, OpenAI-compatible.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# OpenAI takes precedence when set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ── Abuse / cost controls ────────────────────────────────────────────────────
DAILY_REQUEST_BUDGET=3000     # upstream calls per UTC day before 429
RATE_LIMIT_RPS=8              # sustained requests/sec before 429
STARTS_HARDENED=0             # 1 = boot in HARDENED mode

# ── Output-token window — read this before changing either value ─────────────
# The app resolves max_tokens as: min(max(caller_value, MIN), MAX).
# MIN is the one that matters. On a reasoning upstream (Groq's openai/gpt-oss-*,
# o-series) the thinking trace bills against the same completion ceiling as the
# visible answer, so a small ceiling returns finish_reason="length" with an EMPTY
# answer — which every detector reads as the target RESISTING the attack, silently
# turning a whole scan into false negatives. Garak's generators send a small
# max_tokens, so the floor is the only thing that guarantees headroom.
# Measured against openai/gpt-oss-20b: 150 tokens -> empty answer on every call;
# 200+ tokens were spent reasoning before the first visible character.
# MAX must always be >= MIN, or the clamp collapses back onto MAX and undoes this.
MIN_OUTPUT_TOKENS=700         # floor: raise a too-small caller request up to this
MAX_OUTPUT_TOKENS=1024        # ceiling: hard clamp, must be >= MIN_OUTPUT_TOKENS

# ── Identity ─────────────────────────────────────────────────────────────────
# The model id this app advertises. red-prompt classifies target hardening from the
# model name, so advertising the app's own name rather than the upstream one keeps
# the classification honest: from the outside this is an unknown application.
RP_ADVERTISED_MODEL=acme-support-v1

# Optional: served verbatim at /.well-known/red-prompt-target.txt so the endpoint
# can prove it is yours (ownership-verification story, MVP.md gap O).
RP_OWNERSHIP_TOKEN=
