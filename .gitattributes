# Default to LF in the repository, let Git decide the working-copy ending.
* text=auto

# These MUST stay LF in the working copy. Git for Windows checks files out with
# CRLF by default, and a shell script with CRLF line endings fails at the shebang
# with "bad interpreter: /usr/bin/env bash^M". warm.sh is load-bearing on the free
# plan, so it must run from a Windows checkout without a manual fix.
*.sh text eol=lf
Dockerfile text eol=lf

# PowerShell handles either ending; pin CRLF so the file reads native on Windows.
*.ps1 text eol=crlf
